# Framosaic is a client-only app — nothing below is a secret. It's all compiled
# straight into the public browser bundle. Copy this file to .env to override
# the built-in defaults locally; .env is gitignored.

# Link to the public repo, shown in the app header/footer.
VITE_GITHUB_URL=https://github.com/JoghurtSommelier/Framosaic

# Optional donation prompt shown once per session after a successful export.
VITE_DONATION_ENABLED=true
VITE_DONATION_URL=https://buymeacoffee.com/joghurt

# Optional cookie-free analytics id (e.g. Plausible/Umami). Leave empty to disable.
VITE_ANALYTICS_ID=

# Optional Google Analytics (GA4) measurement id, e.g. G-XXXXXXXXXX. Unlike
# VITE_ANALYTICS_ID above, this is cookie-based — it stays off by default and
# only loads after the visitor accepts the consent banner shown once it's set.
VITE_GA_MEASUREMENT_ID=

# Landing page showcase art (spec §5.6) — optional. Leave both unset to use
# the bundled, procedurally-generated placeholder art (public/samples/,
# public/showcase/wall/). Two ways to override, in priority order:
#   1. These env vars (rebuild required).
#   2. A public/showcase/showcase.json manifest (no rebuild — just drop
#      images into public/showcase/banner/ and public/showcase/wall/ and
#      add a showcase.json like:
#      { "banner": ["banner/my-tile-1.webp", ...], "wallSource": "wall/my-wall.jpg", "wallFocus": "50% 30%" }
#      — checked at runtime, ignored if VITE_SHOWCASE_BANNER is set).
# wallSource is rendered into the "See it on the wall" 3x3 Instax Square
# mosaic (real film borders, via the same canvas pipeline as the live
# editor preview) — a roughly square photo works best; wallFocus shifts
# the crop origin ("center", or e.g. "50% 30%") if the subject isn't centered.
# VITE_SHOWCASE_BANNER=/showcase/banner/tile-1.webp,/showcase/banner/tile-2.webp
# VITE_SHOWCASE_WALL_SOURCE=/showcase/wall/my-wall.jpg
# VITE_SHOWCASE_WALL_FOCUS=50% 30%
